# Sanity CMS Configuration
# Get these values by running: npx sanity init
# Or create a project at https://www.sanity.io/manage

NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id-here
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-api-token-here

# Web3Forms (contact form)
NEXT_PUBLIC_WEB3FORMS_KEY=your-web3forms-access-key-here

# Google Analytics 4 Measurement ID (public, client-side).
# Unset = GA not loaded (clean no-op in dev/CI). Set the real G-XXXX value
# in your host's env. NEXT_PUBLIC_* is inlined at build → redeploy after setting.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
